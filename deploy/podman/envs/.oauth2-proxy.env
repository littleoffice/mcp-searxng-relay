# Single sign-on for the SearXNG web UI.  Caddy calls /oauth2/auth on every
# browser request (forward_auth); a 401 sends the browser to sign in with your
# identity provider.  Agents do not use this: /mcp is bearer-only at the
# gateway.  Register a confidential OIDC client at your provider with the
# redirect URI below, then fill in the CHANGEME values.

OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=CHANGEME
OAUTH2_PROXY_CLIENT_ID=CHANGEME
OAUTH2_PROXY_CLIENT_SECRET=CHANGEME
OAUTH2_PROXY_REDIRECT_URL=https://searxng.domain.tld/oauth2/callback
OAUTH2_PROXY_CODE_CHALLENGE_METHOD=S256

# Encrypts the session cookie.  Exactly 32 bytes, URL-safe base64:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=CHANGEME
OAUTH2_PROXY_COOKIE_SECURE=true

# Who may sign in.  "*" admits every account your provider authenticates;
# narrow it to a domain, or require a group/claim with OAUTH2_PROXY_ALLOWED_GROUPS.
OAUTH2_PROXY_EMAIL_DOMAINS=*
#OAUTH2_PROXY_ALLOWED_GROUPS=searxng-users

# Auth-only mode: oauth2-proxy answers Caddy's subrequest with 202 or 401 and
# never proxies to SearXNG itself.  Caddy does that once it says yes.
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_UPSTREAMS=static://202
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
