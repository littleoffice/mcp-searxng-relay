SEARXNG_URL=http://searxng:8080
MCP_PORT=3000
MCP_AUTH_TOKEN=CHANGEME
USER_AGENT=mcp-searxng-relay
MCP_STATELESS=false
LOG_LEVEL=info

# Credential for GET /metrics.  Required to scrape: unset, /metrics returns 401
# to everyone, including callers holding a valid MCP token.  It must NOT be the
# same value as MCP_AUTH_TOKEN above — /metrics discloses the destination hosts
# this relay has fetched across all callers, which is not a tenant's to read.
# Generate with `openssl rand -hex 32`.  Delete this line if you do not scrape.
MCP_METRICS_TOKEN=CHANGEME

# Optional: verify OAuth 2.0 / OIDC bearer JWTs from your own identity provider
# instead of (or alongside) the static MCP_AUTH_TOKEN above. When MCP_OAUTH_ISSUER
# is set the relay discovers the issuer's JWKS and verifies each token's
# signature, iss/aud/exp, and (optionally) a required scope; MCP_AUTH_TOKEN then
# becomes optional. MCP_OAUTH_AUDIENCE is required when the issuer is set.
# See the main README, "OAuth 2.0 / OIDC".
#MCP_OAUTH_ISSUER=https://idp.example.com/realms/main
#MCP_OAUTH_AUDIENCE=https://relay.example.com
#MCP_OAUTH_IDENTITY_CLAIM=sub
#MCP_OAUTH_REQUIRED_SCOPE=
#MCP_OAUTH_JWKS_FILE=/run/secrets/oauth-jwks.json
#MCP_OAUTH_CA_ROOTS=/run/secrets/idp-ca.pem

# Persistent fence signing key, so the verifying gateway in front of the relay
# can pin one fingerprint instead of re-reading it after every restart.  Unset,
# the relay generates a fresh key per process and warns that a gateway cannot
# pin it.  Replace CHANGEME with the output of `openssl rand -base64 32` (the
# relay refuses to start on the placeholder), or delete the line and point the
# _FILE form at a mounted PKCS#8 PEM (`openssl genpkey -algorithm ed25519`).
# Set at most one of the two.  See the main README, "Fence signing key".
FENCE_SIGNING_KEY=CHANGEME
#FENCE_SIGNING_KEY_FILE=/run/secrets/fence-key

# The awareness preamble is signed by default (format 1.1).  Uncomment only
# while the gateway in front of this relay predates format 1.1.
#FENCE_PREAMBLE=prose
