SEARXNG_URL=http://searxng:8080
MCP_PORT=3000
MCP_AUTH_TOKEN=CHANGEME
USER_AGENT=mcp-searxng-relay
MCP_STATELESS=false
LOG_LEVEL=info

# Optional: pin a persistent fence signing key so a verifying gateway can pin
# one fingerprint instead of re-reading it after every restart.  Unset (the
# default) generates a fresh key per process.  Generate one with
# `openssl rand -base64 32`, or point the _FILE form at a mounted PKCS#8 PEM
# (`openssl genpkey -algorithm ed25519`).  Set at most one of the two.
# See the main README, "Fence signing key".
#FENCE_SIGNING_KEY=
#FENCE_SIGNING_KEY_FILE=/run/secrets/fence-key
