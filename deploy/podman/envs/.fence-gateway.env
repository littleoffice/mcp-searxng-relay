MCP_PORT=3001

# Clients present this to the GATEWAY, which is what /mcp now resolves to.
# It must also appear in the relay's token table (envs/.mcp-searxng-relay.env):
# the gateway forwards each caller's credential upstream unchanged, so the same
# value authenticates at both hops and the relay keeps telling callers apart.
MCP_AUTH_TOKEN=CHANGEME

# Forward the calling client's own Authorization header on every tool call,
# instead of substituting the gateway's credential for everyone's.
#
# This is not cosmetic.  The relay files per-caller state — the fetch history
# behind searxng_session_sources, and the rate-limit bucket — under the
# identity its token resolves to.  In `static` mode every client reaches the
# relay as the gateway, so those callers share one history and one bucket, and
# one of them can read the URLs another fetched.  Leave this at passthrough
# unless exactly one client uses this deployment.
UPSTREAM_MCP_AUTH_MODE=passthrough

# The gateway's own credential, and the only thing it uses it for: `initialize`
# and `tools/list` at startup, before any client exists, plus the housekeeping
# the MCP SDK does with no caller attached.  One per gateway, never one per
# caller — no tool call carries it in passthrough mode.  It needs its own line
# in the relay's token table so relay logs attribute that traffic to the
# gateway rather than to whichever client shares the value.
# Generate with `openssl rand -hex 32`.
UPSTREAM_MCP_TOKEN=CHANGEME

# The same credential read from a mounted file instead of the environment.
# Set this or UPSTREAM_MCP_TOKEN, not both.
#UPSTREAM_MCP_TOKEN_FILE=/run/secrets/upstream-token

# More than one client?  Give each its own line here and the same line in the
# relay's table, so both services name the same caller the same way.
#MCP_AUTH_TOKENS=claude-desktop:...,ci-agent:...
#MCP_AUTH_TOKEN_FILE=/run/secrets/gateway-tokens

# Off: one gateway process holds its sessions in memory, which is what a single
# container wants.  Set it true only alongside MCP_STATELESS=true on the relay
# and more than one replica of each — a stateless gateway in front of a
# stateful relay strands the relay's session state.
#MCP_STATELESS=false

# Optional: verify OAuth 2.0 / OIDC bearer JWTs instead of (or alongside) the
# static tokens above.  Passthrough forwards a JWT untouched, so pointing this
# and the relay at the same issuer carries identity end to end in `sub` with no
# shared secrets at all — provided the token's `aud` satisfies both sides.
#MCP_OAUTH_ISSUER=https://idp.example.com/realms/main
#MCP_OAUTH_AUDIENCE=https://gateway.example.com

# Optional: terminate TLS in the gateway instead of at Caddy (both or neither).
#MCP_TLS_CERT=/run/secrets/tls.crt
#MCP_TLS_KEY=/run/secrets/tls.key
